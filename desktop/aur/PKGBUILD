# Maintainer: opendoc-desktop contributors <Raed-Alghamdi@users.noreply.github.com>
#
# opendoc-desktop-bin: OpenDoc on the desktop, built from the release's own pacman package. The app carries its own Electron and
# OpenDoc runtime under /opt/opendoc-desktop, so Arch's shared electron is not used. pkgver is the OpenDoc version and pkgrel the
# build number (the release tag is desktop-v<pkgver>-<pkgrel>). The in-app updater is switched off for this package: pacman owns updates.
pkgname=opendoc-desktop-bin
pkgver=0.6.1
pkgrel=1
pkgdesc='OpenDoc on the desktop, a self-contained app built on the original OpenDoc project'
arch=(x86_64)
url='https://github.com/Raed-Alghamdi/OpenDoc-Desktop'
# The app is MIT; the bundled Chromium carries more licences, listed in LICENSES.chromium.html (installed under /usr/share/licenses).
license=(MIT BSD-3-Clause)
depends=(gtk3 nss libnotify libxss xdg-utils at-spi2-core)
provides=(opendoc-desktop)
conflicts=(opendoc-desktop)
# Prebuilt binaries: stripping would only damage them.
options=(!strip !debug)
install=opendoc-desktop-bin.install
_asset="opendoc-desktop-${pkgver}-${pkgrel}-x64.pacman"
source=("${_asset}::https://github.com/Raed-Alghamdi/OpenDoc-Desktop/releases/download/desktop-v${pkgver}-${pkgrel}/${_asset}")
noextract=("${_asset}")
# The release bump fills this in from the release's checksum for the pacman file.
sha256sums=('SKIP')

package() {
  # The release's package already has the app, the .desktop file and the icons. Drop its own metadata and install script.
  bsdtar -xpf "${srcdir}/${_asset}" -C "${pkgdir}" --exclude='.PKGINFO' --exclude='.MTREE' --exclude='.INSTALL' --exclude='.BUILDINFO'

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/opendoc-desktop/opendoc-desktop "${pkgdir}/usr/bin/opendoc-desktop"

  # Tells the in-app updater the package manager owns this install: no checks, no network (contracts, update rules).
  install -m644 /dev/null "${pkgdir}/opt/opendoc-desktop/resources/update-disabled"

  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  install -m644 "${pkgdir}/opt/opendoc-desktop/LICENSE.electron.txt" "${pkgdir}/opt/opendoc-desktop/LICENSES.chromium.html" \
    "${pkgdir}/usr/share/licenses/${pkgname}/"
  install -m644 "${pkgdir}/opt/opendoc-desktop/resources/runtime/node_modules/opendoc/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.opendoc"
}
